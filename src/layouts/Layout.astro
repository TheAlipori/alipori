---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { ViewTransitions } from "astro:transitions";
import { getLangFromUrl } from "../i18n/utils";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
interface Props {
  title: string;
  description?: string;
  image?: string;
}
const {
  title,
  description = "Portafolio de Alipori — Diseñador gráfico y desarrollador web. Proyectos de branding, diseño UI y desarrollo web a medida.",
  image = "/porilogo.png",
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const canonicalURL = Astro.url.href;
const siteOrigin = Astro.site?.origin ?? "https://www.porilabs.com";
const ogImage = new URL(image, siteOrigin).href;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="../favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Open Graph / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pori Labs" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="600" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="md:px-32 lg:px-52">
    <div id="page-background"></div>
    <Navbar />
    <slot />
    <Footer />
    <script src="../js/main"></script>
  </body><style>
    :root {
      --white: #ffffff;
      --text-muted: rgba(255, 255, 255, 0.8);
      --text-body: rgba(175, 190, 255, 1);
    }

    html,
    body {
      margin: 0;
      width: 100%;
      min-height: 100%;
      font-family: "Poppins", sans-serif;
      background: transparent;
      color: var(--text-body);
    }

    #page-background {
      position: fixed;
      inset: 0;
      z-index: -1;
      background: linear-gradient(
        180deg,
        rgb(21, 38, 113) 10%,
        rgb(27, 44, 120) 30%,
        #5669bd 100%
      );
    }
  </style>
</html>
